{
  "name": "cd-netease-player",
  "version": "1.1.0a",
  "description": "3D CD 盒 × 网易云音乐 — 桌面播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.7.2",
    "@applemusic-like-lyrics/lyric": "^1.1.0",
    "NeteaseCloudMusicApi": "^4.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.cdcase.netease",
    "productName": "CD Netease Player",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signingHashAlgorithms": [],
      "sign": null
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/electron-builder/**",
      "!node_modules/.cache/**"
    ]
  }
}
